{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "types": ["node", "react", "react-dom", "next"], 
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@components/*": [
        "./src/shared/components/*"
      ],
      "@stores/*": [
        "./src/shared/stores/*"
      ],
      "@api/*": [
        "./src/shared/api/*"
      ],
      "@hooks/*": [
        "./src/shared/hooks/*"
      ],
      "@types/*": [
        "./src/shared/types/*"
      ],
      "@styles/*": [
        "./src/shared/styles/*"
      ],
      "@utils/*": [
        "./src/shared/utils/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules"
  ]
}
